# Cấu hình môi trường mẫu cho HaUI Advisor Local Development
# Sao chép thành .env ở thư mục gốc repo trước khi khởi chạy Docker Compose:
# cp .env.example .env

# Database Configuration (PostgreSQL with pgvector)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=haui_advisor
DB_USER=postgres
DB_PASSWORD=local_dev_password_change_in_production

# Backend Service
BACKEND_PORT=8080
SERVER_PORT=8080
SPRING_PROFILES_ACTIVE=default

# Tài khoản & nhập bảng điểm (Task 3.2)
# Tài khoản demo seed từ fixture TV4 (mã SV 2024604757, std-warning-real, ...); để trống mật khẩu thì không tạo
DEMO_ACCOUNTS_ENABLED=false
DEMO_ACCOUNT_PASSWORD=change_me_demo_password
# OCR cho ảnh/PDF scan: disabled (chuyển nhập tay) hoặc tesseract (cần cài tesseract + gói ngôn ngữ vie)
OCR_ENGINE=disabled
# Bật khi chạy sau HTTPS
SESSION_COOKIE_SECURE=false

# Kế hoạch học tập (Task 3.7)
# Công cụ thẩm định thật chưa có thì validate/activate trả 503 TOOL_NOT_READY. Chỉ dev/test (SPRING_PROFILES_ACTIVE=dev)
# mới bật được thẩm định thử; kết quả MOCK không đưa kế hoạch tới VALIDATED/ACTIVE.
ACADEMIC_MOCK_TOOLS=false

# Frontend Web Service
WEB_PORT=5173
VITE_BACKEND_URL=http://localhost:8080

# Trợ lý AI (Task 4.3b)
# Runtime luôn live; AI_MODE=mock (mô hình trả lời thử) chỉ chạy được với SPRING_PROFILES_ACTIVE=dev.
# Để trống GEMINI_API_KEY: Chat trả 503 AI_UNAVAILABLE (thử lại được), hồ sơ/kế hoạch/What-if vẫn chạy bình thường.
AI_MODE=live
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_API_KEY=
# Hạn cho một lượt chat (RAG + công cụ học vụ + mô hình)
AI_CHAT_TIMEOUT=45s

