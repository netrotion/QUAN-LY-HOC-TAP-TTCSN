{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://haui.edu.vn/schemas/source-catalog.schema.json",
  "title": "HaUI Advisor RAG Source Catalog Schema",
  "description": "JSON Schema định nghĩa cấu trúc của danh mục tài liệu quy chế RAG cho HaUI Advisor.",
  "type": "object",
  "required": ["catalog_version", "sources"],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "catalog_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "description": {
      "type": "string"
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "source_id",
          "title",
          "path",
          "version",
          "source_status",
          "rag_enabled",
          "reference_url",
          "sections"
        ],
        "properties": {
          "source_id": {
            "type": "string",
            "pattern": "^REG-HAUI-[0-9]{2}$"
          },
          "title": {
            "type": "string",
            "minLength": 5
          },
          "path": {
            "type": "string",
            "minLength": 3
          },
          "version": {
            "type": "string",
            "pattern": "^gitblob:[0-9a-f]{12}$"
          },
          "source_status": {
            "type": "string",
            "enum": ["PROJECT_GROUND_TRUTH", "DEPRECATED", "DRAFT"]
          },
          "rag_enabled": {
            "type": "boolean"
          },
          "reference_url": {
            "type": "string",
            "format": "uri"
          },
          "sections": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
