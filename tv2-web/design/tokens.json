{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "name": "haui-advisor-tokens",
  "version": "1.0.0",
  "milestone": "design-base-v1",
  "owner": "TV2 - Frontend Platform & Academic Engineer",
  "theme": "Clinical Blueprint on Frosted Paper",
  "description": "Design tokens used across HaUI Advisor web platform (TV2 host and TV3 feature package).",
  "colors": {
    "surfaces": {
      "canvas": "#f5f5f5",
      "paper": "#ffffff",
      "surfaceAlt": "#fafafa",
      "surfaceCard": "#ffffff",
      "bgApp": "#f5f5f5",
      "bgSurface": "#ffffff",
      "bgElevated": "#ffffff",
      "bgMuted": "#fafafa",
      "bgSubtle": "#f0f0f0",
      "bgCode": "#0a0a0a"
    },
    "neutrals": {
      "ink": "#0a0a0a",
      "inkSoft": "#171717",
      "midGray": "#737373",
      "hairline": "#e5e5e5",
      "border": "#e5e5e5",
      "borderStrong": "#d4d4d4",
      "borderFocus": "#0a0a0a",
      "textPrimary": "#0a0a0a",
      "textSecondary": "#404040",
      "textMuted": "#737373",
      "textDisabled": "#a3a3a3",
      "textInverse": "#fafafa",
      "textCode": "#f5f5f5"
    },
    "brand": {
      "primary": "#0052cc",
      "primaryHover": "#1d4ed8",
      "primaryActive": "#1e40af",
      "primaryLight": "#eff6ff",
      "primarySubtle": "#f0f6ff",
      "primaryBorder": "#bfdbfe",
      "primaryScale": {
        "50": "#eff6ff",
        "100": "#dbeafe",
        "200": "#bfdbfe",
        "300": "#93c5fd",
        "400": "#60a5fa",
        "500": "#3b82f6",
        "600": "#0052cc",
        "700": "#1d4ed8",
        "800": "#1e40af",
        "900": "#1e3a8a",
        "950": "#172554"
      },
      "slateScale": {
        "50": "#f8fafc",
        "100": "#f1f5f9",
        "200": "#e2e8f0",
        "300": "#cbd5e1",
        "400": "#94a3b8",
        "500": "#64748b",
        "600": "#475569",
        "700": "#334155",
        "800": "#1e293b",
        "900": "#0f172a",
        "950": "#020617"
      },
      "accent": "#d97706",
      "accentHover": "#b45309",
      "accentLight": "#fef3c7",
      "ember": "#e7000b"
    },
    "status": {
      "success": {
        "base": "#16a34a",
        "hover": "#15803d",
        "bg": "#f0fdf4",
        "border": "#bbf7d0",
        "text": "#166534"
      },
      "warning": {
        "base": "#d97706",
        "hover": "#b45309",
        "bg": "#fffbeb",
        "border": "#fde68a",
        "text": "#92400e"
      },
      "error": {
        "base": "#dc2626",
        "hover": "#b91c1c",
        "bg": "#fef2f2",
        "border": "#fecaca",
        "text": "#991b1b"
      },
      "info": {
        "base": "#0284c7",
        "hover": "#0369a1",
        "bg": "#f0f9ff",
        "border": "#bae6fd",
        "text": "#075985"
      },
      "academicAliases": {
        "passed": "#16a34a",
        "atRisk": "#d97706",
        "failed": "#dc2626",
        "danger": "#dc2626"
      }
    }
  },
  "radii": {
    "cards": "24px",
    "buttons": "18px",
    "inputs": "18px",
    "badges": "18px",
    "nested": "10px",
    "small": "6px",
    "full": "9999px"
  },
  "spacing": {
    "unit": "4px",
    "scale": {
      "0": "0px",
      "1": "4px",
      "2": "8px",
      "3": "12px",
      "4": "16px",
      "5": "20px",
      "6": "24px",
      "8": "32px",
      "10": "40px",
      "12": "48px",
      "16": "64px"
    }
  },
  "typography": {
    "fontFamily": {
      "sans": "'Geist', 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif",
      "mono": "'JetBrains Mono', 'Fira Code', 'Geist Mono', Consolas, Menlo, monospace"
    },
    "scale": {
      "caption": {
        "fontSize": "12px",
        "lineHeight": "1.33",
        "letterSpacing": "0.6px"
      },
      "body": {
        "fontSize": "14px",
        "lineHeight": "1.43"
      },
      "bodyLg": {
        "fontSize": "16px",
        "lineHeight": "1.5"
      },
      "subheading": {
        "fontSize": "18px",
        "lineHeight": "1.56"
      },
      "headingSm": {
        "fontSize": "24px",
        "lineHeight": "1.33",
        "letterSpacing": "-0.6px"
      },
      "heading": {
        "fontSize": "30px",
        "lineHeight": "1.2",
        "letterSpacing": "-0.75px"
      },
      "headingLg": {
        "fontSize": "36px",
        "lineHeight": "1.11",
        "letterSpacing": "-0.9px"
      },
      "display": {
        "fontSize": "48px",
        "lineHeight": "1.1",
        "letterSpacing": "-2.4px"
      }
    },
    "weights": {
      "regular": 400,
      "medium": 500,
      "semibold": 600,
      "bold": 700
    }
  },
  "shadows": {
    "subtle": "0 0 0 1px rgba(23, 23, 23, 0.05), 0 1px 3px 0 rgba(0, 0, 0, 0.08), 0 1px 2px -1px rgba(0, 0, 0, 0.06)",
    "card": "0 0 0 1px rgba(23, 23, 23, 0.05), 0 1px 3px 0 rgba(0, 0, 0, 0.08), 0 1px 2px -1px rgba(0, 0, 0, 0.06)",
    "dropdown": "0 4px 6px -1px rgba(0, 0, 0, 0.08), 0 2px 4px -2px rgba(0, 0, 0, 0.06)",
    "modal": "0 20px 25px -5px rgba(0, 0, 0, 0.12), 0 8px 10px -6px rgba(0, 0, 0, 0.08)"
  },
  "layout": {
    "sidebarWidth": "268px",
    "sidebarWidthCollapsed": "72px",
    "topbarHeight": "64px",
    "contentMaxWidth": "1280px",
    "cardPadding": "20px",
    "transitionFast": "150ms cubic-bezier(0.4, 0, 0.2, 1)",
    "transitionBase": "220ms cubic-bezier(0.4, 0, 0.2, 1)"
  }
}
